# ArgusGrid runtime configuration (no secrets here). Copied to backend\config\app.env by the setup.
ARGUS_ENV=production
# civil | defense (ARG-021). defense: offline intelligence bundles only, marking banner, longer retention.
ARGUS_PROFILE=civil
ARGUS_BIND_HOST=127.0.0.1
# set to 1 when the site is served over HTTPS
ARGUS_SECURE_COOKIES=0
ARGUS_WORKERS=1
